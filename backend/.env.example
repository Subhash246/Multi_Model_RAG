ENVIRONMENT=development

# Must match the URL LiteLLM proxy is running on (see litellm_config.yaml)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-dev-key
DEFAULT_MODEL=local-llama3

REQUEST_TIMEOUT_SECONDS=120

MAX_UPLOAD_MB=50
UPLOAD_DIR=./data/uploads

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multimodal_rag

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false